{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "50 19 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "55 19 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "00 20 * * *"
    }
  ]
}